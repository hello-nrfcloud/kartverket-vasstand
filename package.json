  "description": "Publishes the seawater levels from https://www.kartverket.no/ as custom devices on hello.nrfcloud.com/map",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test --test-reporter spec \"!(dist|node_modules)/**/*.spec.ts\"",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/kartverket-vasstand.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/kartverket-vasstand/issues"
  },
  "homepage": "https://hello.nrfcloud.com/map/#id:flashing-entozoic-filatory!s:model:kartverket-vasstandsdata!m:4.257012404239944:65.99607475371971,16.771625841773357!t:describe-model:di;14230;0",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud",
    "map",
    "aws",
    "cdk"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-iam": "3.1116.0",
    "@aws-sdk/client-ssm": "3.1116.0",
    "@bifravst/aws-cdk-lambda-helpers": "5.0.5",
    "@bifravst/ci": "3.0.1",
    "@bifravst/eslint-config-typescript": "8.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/xml2js": "0.4.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1138.0",
    "aws-cdk-lib": "2.266.0",
    "cdk": "2.1138.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "constructs": "10.8.1",
    "husky": "9.1.7",
    "nock": "14.0.17",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@bifravst/aws-ssm-settings-helpers": "2.0.1",
    "@bifravst/from-env": "4.0.0",
    "@hello.nrfcloud.com/proto": "16.0.0",
    "@hello.nrfcloud.com/proto-map": "17.1.1",
